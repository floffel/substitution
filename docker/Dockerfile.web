################################################################################
# DOCKERFILE FOR WEB PLATFORM TESTING
#
# Builds a Flutter web test environment for the Substitution app.
# Uses Chrome/Chromium as the browser for integration tests.
#
# Build: docker build -f docker/Dockerfile.web -t substitution-web-test .
# Run:   docker-compose run web-test
################################################################################

FROM ubuntu:22.04

LABEL maintainer="Substitution Team"
LABEL description="Flutter Web Platform Testing Environment"

# Set timezone
ENV TZ=UTC
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build tools
    build-essential \
    cmake \
    pkg-config \
    # Git
    git \
    curl \
    # For web testing
    chromium-browser \
    chromium-codecs-ffmpeg \
    # Dependencies
    libssl-dev \
    libffi-dev \
    libsqlite3-0 \
    libsqlite3-dev \
    fonts-dejavu \
    # Cleanup
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Install Flutter (stable channel)
ENV FLUTTER_HOME=/opt/flutter
RUN git clone --depth 1 https://github.com/flutter/flutter.git \
    -b stable $FLUTTER_HOME && \
    $FLUTTER_HOME/bin/flutter config --no-analytics && \
    $FLUTTER_HOME/bin/flutter precache

# Add Flutter to PATH
ENV PATH=$FLUTTER_HOME/bin:$FLUTTER_HOME/bin/cache/dart-sdk/bin:$PATH

# Verify Flutter installation
RUN flutter doctor -v && \
    dart --version

WORKDIR /project

# Configure Flutter for web
RUN flutter config --enable-web

# Pre-cache web platform
RUN flutter web --version

ENTRYPOINT ["/bin/bash"]
CMD ["-c", "flutter test integration_test/ -d web-server --verbose"]
