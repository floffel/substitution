################################################################################
# DOCKERFILE FOR LINUX PLATFORM TESTING
#
# Builds a Flutter Linux testing environment for unit tests.
# Note: GTK integration tests cannot run headless in Docker.
# This image is configured for CPU tests (business logic) only.
#
# Build: docker build -f docker/Dockerfile.linux -t substitution-linux-test .
# Run:   docker-compose run linux-cpu-test
################################################################################

FROM ubuntu:22.04

LABEL maintainer="Substitution Team"
LABEL description="Flutter Linux Platform CPU Testing Environment (Unit Tests Only)"

# Build arguments
ARG FLUTTER_VERSION=stable

# Set timezone
ENV TZ=UTC
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build tools
    build-essential \
    cmake \
    pkg-config \
    # Git
    git \
    curl \
    # GTK dependencies (for compilation, not runtime in headless)
    libgtk-3-dev \
    libglu1-mesa \
    # Compilation
    clang \
    ninja-build \
    # Dependencies
    libssl-dev \
    libffi-dev \
    libsqlite3-0 \
    libsqlite3-dev \
    fonts-dejavu \
    # Cleanup
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Install Flutter (stable channel)
ENV FLUTTER_HOME=/opt/flutter
RUN git clone --depth 1 https://github.com/flutter/flutter.git \
    -b ${FLUTTER_VERSION} $FLUTTER_HOME && \
    $FLUTTER_HOME/bin/flutter config --no-analytics && \
    $FLUTTER_HOME/bin/flutter precache

# Add Flutter to PATH
ENV PATH=$FLUTTER_HOME/bin:$FLUTTER_HOME/bin/cache/dart-sdk/bin:$PATH

# Verify Flutter installation
RUN flutter doctor -v && \
    dart --version

WORKDIR /project

# Configure Flutter for Linux (compilation only, not runtime tests)
RUN flutter config --enable-linux-desktop

# Pre-cache Linux platform
RUN flutter precache --linux

ENTRYPOINT ["/bin/bash"]
CMD ["-c", "flutter test test/ --verbose"]
